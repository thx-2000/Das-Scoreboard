# PHP-Fehler nie direkt im Browser anzeigen (koennte sonst Serverpfade oder
# SQL-Details preisgeben) - stattdessen ins Server-Error-Log schreiben.
# Wird stillschweigend ignoriert, falls der Host mod_php nicht nutzt (z.B.
# PHP-FPM) - dort muss display_errors stattdessen ueber php.ini/Hoster-Panel
# deaktiviert sein.
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# VERSION-Datei und SQLite-Dateien niemals direkt ausliefern
<FilesMatch "^(VERSION|.*\.sqlite.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Seiten wurden von .html auf .php umgestellt (gemeinsamer Header/Nav via
# PHP-Includes statt Duplikat je Seite). Diese Weiterleitung haelt bereits
# installierte PWA-Homescreen-Icons und alte Lesezeichen (start_url/Links
# auf *.html) funktionsfaehig, ohne dass Nutzer die App neu installieren
# muessten.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)\.html$ $1.php [L]
</IfModule>

# Grundlegende Security-Header site-weit (zusaetzlich zum SVG-spezifischen
# CSP in api/logo.php). Kein globales CSP hier, da das Theme-System per
# Inline-<style>-Block arbeitet (siehe includes/settings.php::
# render_theme_style_css()) - ein striktes CSP bräuchte 'unsafe-inline'
# fuer style-src und würde dadurch kaum echten Schutz bringen.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
